# SPDX-License-Identifier: MIT
# Doxygen configuration for FVQual.
#
# Follows the HydroCoupleSDK / HydroCouple interface-definition pipeline:
# the doxygen-awesome theme, README.md as the main page, and the \threadsafety
# and \license aliases the headers already use.

PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_NUMBER         = "@FVQual_FULL_VERSION@"
PROJECT_BRIEF          = "3D unstructured finite-volume hydrodynamic and water-quality engine"

OUTPUT_DIRECTORY       = @CMAKE_CURRENT_BINARY_DIR@/doxygen
CREATE_SUBDIRS         = YES
OUTPUT_LANGUAGE        = English
DOXYFILE_ENCODING      = UTF-8

# The headers carry the documentation; extracting undocumented members too
# keeps the class pages complete rather than showing a partial interface.
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_PACKAGE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
INHERIT_DOCS           = YES
SORT_MEMBER_DOCS       = YES

INPUT                  = @CMAKE_SOURCE_DIR@/include \
                         @CMAKE_SOURCE_DIR@/src \
                         @CMAKE_SOURCE_DIR@/README.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = @CMAKE_SOURCE_DIR@/README.md
FILE_PATTERNS          = *.h *.hpp *.cpp *.c *.md

# Interface classes are named IPressureClosure, ITransportEngine and so on;
# stripping the prefix keeps the alphabetical index usable.
IGNORE_PREFIX          = I

# Undocumented public API is a defect, not a warning to scroll past.
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_LOGFILE           = @CMAKE_CURRENT_BINARY_DIR@/doxygen_warnings.log

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
HTML_HEADER            = @CMAKE_CURRENT_SOURCE_DIR@/custom/html/header.html
HTML_EXTRA_STYLESHEET  = @CMAKE_CURRENT_SOURCE_DIR@/custom/css/doxygen-awesome.css \
                         @CMAKE_CURRENT_SOURCE_DIR@/custom/hydrocouple/hc-fonts.css \
                         @CMAKE_CURRENT_SOURCE_DIR@/custom/hydrocouple/hc-tokens.css \
                         @CMAKE_CURRENT_SOURCE_DIR@/custom/hydrocouple/hc-diagrams.css \
                         @CMAKE_CURRENT_SOURCE_DIR@/custom/hydrocouple/hydrocouple-doxygen.css
HTML_EXTRA_FILES       = @CMAKE_CURRENT_SOURCE_DIR@/custom/js/doxygen-awesome-darkmode-toggle.js \
                         @CMAKE_CURRENT_SOURCE_DIR@/custom/js/doxygen-awesome-fragment-copy-button.js \
                         @CMAKE_CURRENT_SOURCE_DIR@/custom/js/doxygen-awesome-interactive-toc.js \
                         @CMAKE_CURRENT_SOURCE_DIR@/custom/js/doxygen-awesome-paragraph-link.js \
                         @CMAKE_CURRENT_SOURCE_DIR@/custom/js/doxygen-awesome-tabs.js \
                         @CMAKE_CURRENT_SOURCE_DIR@/custom/hydrocouple/hc-doxygen.js \
                         @CMAKE_CURRENT_SOURCE_DIR@/custom/hydrocouple/hc-diagrams.js \
                         @CMAKE_CURRENT_SOURCE_DIR@/custom/hydrocouple/hydrocouple_logo.png \
                         @CMAKE_CURRENT_SOURCE_DIR@/custom/hydrocouple/inter-greek.woff2 \
                         @CMAKE_CURRENT_SOURCE_DIR@/custom/hydrocouple/inter-latin-ext.woff2 \
                         @CMAKE_CURRENT_SOURCE_DIR@/custom/hydrocouple/inter-latin.woff2 \
                         @CMAKE_CURRENT_SOURCE_DIR@/custom/hydrocouple/jetbrains-mono-greek.woff2 \
                         @CMAKE_CURRENT_SOURCE_DIR@/custom/hydrocouple/jetbrains-mono-latin-ext.woff2 \
                         @CMAKE_CURRENT_SOURCE_DIR@/custom/hydrocouple/jetbrains-mono-latin.woff2 \
                         @CMAKE_CURRENT_SOURCE_DIR@/custom/hydrocouple/sora-latin-ext.woff2 \
                         @CMAKE_CURRENT_SOURCE_DIR@/custom/hydrocouple/sora-latin.woff2 \
                         @CMAKE_CURRENT_SOURCE_DIR@/custom/hydrocouple/inter-OFL.txt \
                         @CMAKE_CURRENT_SOURCE_DIR@/custom/hydrocouple/jetbrainsmono-OFL.txt \
                         @CMAKE_CURRENT_SOURCE_DIR@/custom/hydrocouple/sora-OFL.txt
HTML_COLORSTYLE_HUE    = 220
HTML_COLORSTYLE_SAT    = 174
HTML_COLORSTYLE_GAMMA  = 84

GENERATE_TODOLIST      = YES
GENERATE_TESTLIST      = YES
GENERATE_BUGLIST       = YES
GENERATE_DEPRECATEDLIST = YES

# \threadsafety is used throughout the headers; \license keeps the license
# statement identical everywhere rather than retyped per file.
ALIASES                = "threadsafety=\par Thread Safety^^" \
                         "license=\par License^^MIT — see LICENSE in the repository root.^^"

# Call and caller graphs are worth the build time here: the mode-splitting
# driver is the one place where reading the call order is how the design is
# understood.
HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = NO
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_GRAPH_MAX_NODES    = 60

# The C API is compiled under a build-side define; without it the export
# macros expand inconsistently and the ABI surface documents wrongly.
PREDEFINED             = FVQual_CAPI_BUILD \
                         FVQual_EXPORT= \
                         FVQual_NO_EXPORT= \
                         FVQual_CAPI=
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES

GENERATE_LATEX         = NO
